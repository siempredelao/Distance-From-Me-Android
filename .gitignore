## Android Studio
#################

# Android Studio
build
.idea
.gradle

# Local configuration file (sdk path, etc)
local.properties
*.iml

# API keys specific to build variants
**/src/*/res/values/other.xml

# Keystore properties (local signing config)
keystore.properties

# fastlane's report of its last run
fastlane/report.xml

# Play Store pictures, kept only on this computer because of their size
/art/play-store/**/*.png

# Personal Claude Code settings
.claude/settings.local.json
